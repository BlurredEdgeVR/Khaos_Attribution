{
  "schema_version": "1",
  "id": "stable-audio-3",
  "name": "Stable Audio 3 Medium",
  "version": "3.0-medium",
  "code": {
    "repo": "https://github.com/Stability-AI/stable-audio-3.git",
    "commit": "77e0398c26f7d22d801ec1bb036307e8b231f741",
    "commit_note": "The trial's pin. The CUDA trainer and renderer are the package; the Apple silicon path is the MLX port under optimized/mlx in the same checkout."
  },
  "licence": {
    "name": "Stability AI Community License",
    "notice": "Stable Audio 3 is under the Stability AI Community License. Its text encoder is Google's t5gemma-b-b-ul2, shipped inside Stability's model repository under Google's Gemma terms; Stability's repository is opened to each user who accepts its terms on Hugging Face.",
    "obligations": [
      "Stability AI Community License: free below its revenue threshold; the attribution it asks for is shown where the base model is named.",
      "Gemma Terms of Use for the text encoder: access is granted per user by Google; Khaos redistributes the encoder only once the terms are confirmed to allow it."
    ]
  },
  "weights": [
    {
      "name": "stable-audio-3-medium-base",
      "repo": "stabilityai/stable-audio-3-medium-base",
      "required": true,
      "runtime": "torch",
      "components": [
        "model.safetensors",
        "model_config.json"
      ]
    },
    {
      "name": "stable-audio-3-medium",
      "repo": "stabilityai/stable-audio-3-medium",
      "required": true,
      "runtime": "torch",
      "patterns": [
        "t5gemma-b-b-ul2/*"
      ],
      "components": [
        "t5gemma-b-b-ul2/config.json",
        "t5gemma-b-b-ul2/model.safetensors",
        "t5gemma-b-b-ul2/tokenizer.json",
        "t5gemma-b-b-ul2/tokenizer_config.json",
        "t5gemma-b-b-ul2/special_tokens_map.json",
        "t5gemma-b-b-ul2/tokenizer.model"
      ],
      "gated": true,
      "gated_by": "Stability's terms, accepted once on Hugging Face; Google's Gemma terms apply to the encoder inside"
    },
    {
      "name": "stable-audio-3-optimized",
      "repo": "stabilityai/stable-audio-3-optimized",
      "required": true,
      "runtime": "mlx",
      "components": [
        "models/mlx/dit_medium-base_f16.npz",
        "models/mlx/dit_medium_f16.npz",
        "models/mlx/same_l_decoder_f32.npz",
        "models/mlx/same_l_encoder_f32.npz",
        "models/mlx/t5gemma_f16.npz"
      ]
    }
  ],
  "platforms": {
    "cuda": [
      "train",
      "render"
    ],
    "mps": [
      "train",
      "render"
    ]
  },
  "conditioning": {
    "tempo": false,
    "key": false,
    "time_signature": false,
    "lyrics": false,
    "vocal_language": false,
    "trigger": true,
    "duration": true
  },
  "sings": false,
  "sample_rate": 44100,
  "variants": {
    "base": {
      "config": "medium-base",
      "render": {
        "steps": 50,
        "guidance_scale": 7.0,
        "apg_scale": 1.0
      },
      "note": "Adapters train and render on the un-distilled base checkpoint (50 steps, guidance 7), so an adapter is served on the weights it trained on. The distilled 'medium' checkpoint (8 steps, guidance 1) is not used for adapters."
    }
  },
  "default_variant": "base",
  "render_setting_keys": [
    "steps",
    "guidance_scale",
    "apg_scale"
  ],
  "bounds": {
    "duration_seconds": [
      5,
      120
    ],
    "steps": [
      1,
      200
    ],
    "bpm": [
      30,
      300
    ],
    "takes": [
      1,
      16
    ]
  },
  "rework_modes": [
    "retake",
    "repaint",
    "audio2audio"
  ],
  "adapter": {
    "type": "lora",
    "filenames": [
      "adapter_model.safetensors"
    ],
    "resumable": true
  },
  "measure": {
    "feature_version": "unmeasured"
  },
  "train": {
    "learning_rate": 0.0001,
    "adapter_rank": 16,
    "adapter_alpha": 16,
    "adapter_type": "lora"
  },
  "memory": {
    "resident_gb": 0.0,
    "yielded_gb": 0.0,
    "scorer": {
      "base_gb": 8.7,
      "gb_per_sec": 0.0,
      "checkpointed_gb": 8.7,
      "checkpointed_gb_per_sec": 0.0,
      "process_gb": 0.5
    }
  }
}
