{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BlurredEdgeVR/Khaos_Attribution/schemas/attribution_estimate.schema.json",
  "title": "Attribution Estimate",
  "description": "An ESTIMATE of how much each training track influenced one generated output, and the writer/publisher splits that follow from it. This document is a methodology-stamped estimate with uncertainty ranges, never a legal statement of ownership. It never replaces the provenance record; it rides alongside it.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.0"
    },
    "generation_id": {
      "type": "string",
      "minLength": 1
    },
    "artist_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "method": {
      "type": "object",
      "description": "Exactly how this estimate was computed \u2014 an estimate without its method is a rumour.",
      "properties": {
        "estimator_version": {
          "type": "string",
          "minLength": 1
        },
        "exposure_basis": {
          "type": "string",
          "description": "What the exposure prior counts, e.g. 'training segments per track'."
        },
        "embedding_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "embedding_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "similarity_informative": {
          "type": "boolean",
          "description": "False when the acoustic similarity spread across tracks was below the noise floor, in which case blended shares equal the exposure prior."
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "description": "Softmax temperature used to turn similarity scores into weights; null when similarity was uninformative."
        }
      },
      "required": [
        "estimator_version",
        "exposure_basis",
        "similarity_informative"
      ],
      "additionalProperties": true
    },
    "influence": {
      "type": "array",
      "description": "Per-track influence estimates, percentages of the output. Blended shares plus nothing else sum to 100.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "exposure_share_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "similarity_share_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "blended_share_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "share_range_pct": {
            "type": "array",
            "description": "[low, high] \u2014 the disagreement interval across methods. A number outside this range is a claim no method made.",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "track_id",
          "exposure_share_pct",
          "similarity_share_pct",
          "blended_share_pct",
          "share_range_pct"
        ],
        "additionalProperties": false
      }
    },
    "splits": {
      "type": "object",
      "description": "The money math: each party's estimated share of this output, from track influence \u00d7 their share of each track.",
      "properties": {
        "writers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/party_split"
          }
        },
        "publishers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/party_split"
          }
        },
        "unattributed_pct": {
          "type": "number",
          "description": "Influence attributable to tracks with no rights record. Reported, never silently renormalised away.",
          "minimum": 0,
          "maximum": 100
        },
        "masters": {
          "type": "array",
          "description": "Recording-owner shares of the output, when any influencing track carries a masters pool.",
          "items": {
            "$ref": "#/$defs/party_split"
          }
        }
      },
      "required": [
        "writers",
        "publishers",
        "unattributed_pct"
      ],
      "additionalProperties": false
    },
    "caveats": {
      "type": "array",
      "description": "Everything the reader must know before quoting a number, in plain sentences.",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "generation_id",
    "artist_id",
    "adapter_version",
    "created_at",
    "method",
    "influence",
    "splits",
    "caveats"
  ],
  "additionalProperties": false,
  "$defs": {
    "party_split": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "share_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "share_range_pct": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "name",
        "share_pct",
        "share_range_pct"
      ],
      "additionalProperties": false
    }
  }
}
